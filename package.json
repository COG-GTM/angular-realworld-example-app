{
  "name": "react-realworld",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "setup": "git submodule init && git submodule update && npm install",
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,html,css,json,md}\"",
    "test:e2e": "playwright test --grep-invert @security",
    "test:e2e:security": "playwright test --grep @security",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:disabled": "cat e2e/DISABLED_TESTS.md"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dompurify": "^3.3.3",
    "marked": "^17.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "~5.5.4",
    "vite": "^5.4.0"
  }
}
