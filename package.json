{
  "name": "conduit-react",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "git submodule init && git submodule update && bun install",
    "dev": "vite",
    "build": "tsc -p tsconfig.react.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --grep-invert @security",
    "test:e2e:security": "playwright test --grep @security",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:disabled": "cat e2e/DISABLED_TESTS.md",
    "format": "prettier --write \"**/*.{ts,tsx,html,css,json,md}\" \"!realworld/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,css,json,md}\" \"!realworld/**\"",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "private": true,
  "dependencies": {
    "marked": "^17.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/marked": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/ui": "^4.0.18",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,html,css,json,md}": "prettier --write"
  }
}
